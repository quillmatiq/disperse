---
import Base from "../layouts/Base.astro";
import ShareScreen from "../components/ShareScreen.svelte";

const initialUrl = Astro.url.searchParams.get("url") || Astro.url.searchParams.get("text") || "";
---
<Base>
  <div id="app">
    <ShareScreen client:load initialUrl={initialUrl} />
  </div>
</Base>
