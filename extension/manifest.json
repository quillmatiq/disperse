{
  "manifest_version": 3,
  "name": "Disperse",
  "version": "0.1.0",
  "description": "Share links to multiple destinations in the Atmosphere",
  "permissions": ["activeTab"],
  "background": {
    "service_worker": "background.js",
    "type": "module",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Share with Disperse"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "disperse@disperse.social",
      "strict_min_version": "101.0",
      "data_collection_permissions": {
        "required": ["none"],
        "optional": []
      }
    }
  }
}
